rules_version = '2';

// Quy tắc bảo mật Firestore cho phần mềm quản lý trung tâm Sky.
// - admin: toàn quyền.
// - teacher (giáo viên chính hoặc trợ giảng): chỉ đọc/ghi dữ liệu của lớp mình dạy
//   (uid của giáo viên nằm trong mảng teacherIds của tài liệu).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && profile().role == 'admin' && profile().active != false; }
    function isTeacher() { return hasProfile() && profile().role == 'teacher' && profile().active != false; }
    function owns(data) { return isTeacher() && request.auth.uid in data.teacherIds; }
    function ownsClass(classId) {
      return isTeacher() && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if hasProfile();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isAdmin() || (owns(request.resource.data) && ownsClass(request.resource.data.classId));
      allow update: if isAdmin() || (owns(resource.data) && owns(request.resource.data) && ownsClass(request.resource.data.classId));
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /attendance/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isAdmin() || (owns(request.resource.data) && ownsClass(request.resource.data.classId));
      allow update: if isAdmin() || (owns(resource.data) && owns(request.resource.data));
      allow delete: if isAdmin() || owns(resource.data);
    }

    // Điểm danh giáo viên (số tiết dạy để tính lương)
    match /teacherAttendance/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isAdmin() || (owns(request.resource.data) && ownsClass(request.resource.data.classId));
      allow update: if isAdmin() || (owns(resource.data) && owns(request.resource.data));
      allow delete: if isAdmin();
    }

    match /assessments/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isAdmin() || (owns(request.resource.data) && ownsClass(request.resource.data.classId));
      allow update: if isAdmin() || (owns(resource.data) && owns(request.resource.data));
      allow delete: if isAdmin() || owns(resource.data);
    }

    // Học phí học sinh: giáo viên chỉ xem, chỉ quản trị viên ghi nhận đã thu.
    match /payments/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }

    // Trả lương giáo viên: giáo viên chỉ xem của chính mình.
    match /payouts/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
